# Copy to .env.local for local development.
DATABASE_URL=postgres://socratease:socratease@localhost:54329/socratease

# Auth.js. Generate the secret with: openssl rand -base64 33
AUTH_SECRET=
# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# The single Teacher (ADR: exactly one Teacher per real Cohort)
TEACHER_EMAIL=

# AI provider (ADR 0006): "vertex" in production. Locally: "local" (Claude via ANTHROPIC_API_KEY +
# embeddings on this machine; fictional test Course only) or "fake" (no AI at all).
AI_PROVIDER=fake
ANTHROPIC_API_KEY=
# Google Cloud project for Vertex AI (only when AI_PROVIDER=vertex)
GCP_PROJECT_ID=
