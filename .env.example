# Copy to .env.local for local development.
DATABASE_URL=postgres://socratease:socratease@localhost:54329/socratease

# Auth.js. Generate the secret with: openssl rand -base64 33
AUTH_SECRET=
# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# The single Teacher (ADR: exactly one Teacher per real Cohort)
TEACHER_EMAIL=

# AI provider (ADR 0006): "vertex" in production. Locally: "local" (Claude via ANTHROPIC_API_KEY +
# embeddings on this machine; fictional test Course only) or "fake" (no AI at all).
AI_PROVIDER=fake
ANTHROPIC_API_KEY=
# Google Cloud project for Vertex AI (only when AI_PROVIDER=vertex)
GCP_PROJECT_ID=
# On Vercel only: sign in to Google Cloud through Vercel OIDC and Workload Identity Federation,
# without a stored key. Locally, `gcloud auth application-default login` is used instead.
GCP_PROJECT_NUMBER=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_PROVIDER_ID=
GCP_SERVICE_ACCOUNT_EMAIL=


# Notion integration for Sync (ADR 0007): Read content only, shared with the Cohort's root page only
NOTION_TOKEN=
# Protects /api/sync; Vercel sends it with each cron call. Generate with: openssl rand -base64 33
CRON_SECRET=

# Messages a Student may send per day (default 50). The Teacher has no limit.
DAILY_MESSAGE_LIMIT=
# Secret behind Students' usage keys (falls back to AUTH_SECRET). Generate with: openssl rand -base64 33
USAGE_KEY_SECRET=
